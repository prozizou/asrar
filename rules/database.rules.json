{
  "rules": {
    ".read": false,
    ".write": false,

    "notification_jobs": { ".indexOn": ["availableAt", "createdAt", "finishedAt", "status"] },
    "notifications": { "$uid": { ".indexOn": ["createdAt", "read"] } },
    "zikr_chat_read_counts": {
      "$gid": {
        "$uid": {
          ".read": "auth != null && auth.uid == $uid && auth.token.email_verified == true && root.child('zikr_members').child($gid).child(auth.uid).exists() && !root.child('zikr_members').child($gid).child(auth.uid).child('removalId').exists()",
          ".write": false
        }
      }
    },
    "zikr_chat_signals": {
      "$gid": {
        ".read": "auth != null && auth.token.email_verified == true && root.child('zikr_members').child($gid).child(auth.uid).exists() && !root.child('zikr_members').child($gid).child(auth.uid).child('removalId').exists()",
        ".write": false
      }
    },
    "zikr_inactivity": { ".indexOn": ["deadline"] },
    "zikr_groups": { ".indexOn": ["sessionAt"] },
    "product_requests": { "$vendorId": { ".indexOn": ["uid", "at"] } },
    "orders_v2": { ".indexOn": ["buyerSort", "sellerSort", "sellerUid", "buyerUid", "at"] },
    "privacy_requests": { ".indexOn": ["status"] },
    "orders": { "$uid": { ".indexOn": ["at"] } },
    "push_subscriptions": { "$uid": { ".indexOn": ["updatedAt"] } },
    "fcm_devices": { "$uid": { ".indexOn": ["updatedAt"] } },

    "ac_signals": {
      "$cid": { ".read": "auth != null && auth.token.email_verified == true && root.child('ac_members').child($cid).child(auth.uid).exists()", ".write": false }
    },
    "ac_inbox_signals": {
      "$uid": { ".read": "auth != null && auth.uid == $uid && auth.token.email_verified == true", ".write": false }
    },
    "ac_typing": {
      "$cid": {
        ".read": "auth != null && auth.token.email_verified == true && root.child('ac_members').child($cid).child(auth.uid).exists()",
        "$uid": {
          ".write": "auth != null && auth.uid == $uid && auth.token.email_verified == true && root.child('ac_members').child($cid).child(auth.uid).exists() && !root.child('ac_suspended').child(auth.uid).exists()",
          ".validate": "newData.isNumber() && newData.val() <= now + 5000 && newData.val() >= now - 60000"
        }
      }
    },
    "ac_profiles": { ".indexOn": ["handle", "seller/enabled"] },
    "ac_posts": { ".indexOn": ["createdAt", "sellerUid"] },
    "ac_convs": { ".indexOn": ["inviteCode", "visibility"] },
    "ac_orders": { ".indexOn": ["status"] },
    "ac_reports": { ".indexOn": ["status"] },
    "ac_audit": { ".indexOn": ["at"] },

    "sourate": { ".read": "auth != null" },
    "versetRef": { ".read": "auth != null" },
    "data": {
      "appData": { ".read": "auth != null" }
    }
  }
}
