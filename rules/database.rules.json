{
  "rules": {
    ".read": false,
    ".write": false,

    "notification_jobs": { ".indexOn": ["availableAt", "createdAt", "finishedAt", "status"] },
    "notifications": { "$uid": { ".indexOn": ["createdAt", "read"] } },
    "zikr_groups": { ".indexOn": ["sessionAt"] },
    "push_subscriptions": { "$uid": { ".indexOn": ["updatedAt"] } },
    "fcm_devices": { "$uid": { ".indexOn": ["updatedAt"] } },

    "sourate": { ".read": "auth != null" },
    "versetRef": { ".read": "auth != null" },
    "data": {
      "appData": { ".read": "auth != null" }
    }
  }
}
