// Règles Firestore — ASRAR PRO (migration RTDB → Firestore, Phase 0).
//
// MÊME PRINCIPE que rules/database.rules.json (RTDB) : tout est fermé par
// défaut. Quasiment toute la logique de l'app passe par le SDK Admin
// côté serveur (pages/api/*.js), qui CONTOURNE totalement ces règles —
// elles ne s'appliquent qu'aux 3 lectures directes restantes côté client
// (lib/alqalam.js, lib/benefits.js, lib/rouwhania.js : lectures de secours
// à froid, jamais de listener temps réel, jamais d'écriture).
//
// DÉPLOIEMENT : pas de `firebase` CLI dans cet environnement — poussées
// directement via l'API REST Firebase Rules (firebaserules.googleapis.com,
// create ruleset + update release cloud.firestore) avec le compte de
// service. Ce fichier DOIT rester synchronisé avec la version réellement
// déployée : toute modification ici doit être repoussée par le même moyen
// (ou `firebase deploy --only firestore:rules` si la CLI devient
// disponible), sinon la version en ligne diverge silencieusement de ce
// fichier — comme ça a été le cas jusqu'à la Phase 3 (règles par défaut
// "tout refusé" restées en place depuis la création de la base, malgré ce
// fichier déjà présent depuis la Phase 0).
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Fermé par défaut — toute collection non listée explicitement
    // ci-dessous n'est accessible que via le SDK Admin (serveur).
    match /{document=**} {
      allow read, write: if false;
    }

    // Les 3 seules lectures directes client (voir database.rules.json :
    // sourate, versetRef, data/appData → ici sourate, verset_refs,
    // asma_ul_husna) — authentification requise, jamais d'écriture.
    match /sourate/{id} {
      allow read: if request.auth != null;
    }
    match /verset_refs/{id} {
      allow read: if request.auth != null;
    }
    match /asma_ul_husna/{id} {
      allow read: if request.auth != null;
    }
  }
}
