<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="planet_alarm_clock.xml" />
        <exclude domain="sharedpref" path="planet_alarm_diagnostics.xml" />
        <!-- Session de connexion (Firebase, IndexedDB/localStorage de la WebView) :
             jamais copiée vers une sauvegarde ni un autre téléphone. -->
        <exclude domain="root" path="app_webview/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="planet_alarm_clock.xml" />
        <exclude domain="sharedpref" path="planet_alarm_diagnostics.xml" />
        <!-- Session de connexion (Firebase, IndexedDB/localStorage de la WebView) :
             jamais copiée vers une sauvegarde ni un autre téléphone. -->
        <exclude domain="root" path="app_webview/" />
    </device-transfer>
</data-extraction-rules>
