{
  "name": "asrar-next",
  "version": "0.2.3",
  "private": true,
  "description": "ASRAR PRO — application Next.js/React. Migration terminée : toutes les rubriques (secrets, marché, boutique, bibliothèque, calculs ésotériques…) sont servies par cette app, plus de site statique séparé.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "test:runtime": "node scripts/check-server-runtime.cjs",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.lib.json",
    "test:e2e": "playwright test",
    "test:auth": "node scripts/test-auth.cjs",
    "cap:sync": "cap sync android",
    "android:apk": "cap sync android && cd android && ./gradlew assembleDebug assembleRelease",
    "android:aab": "cap sync android && cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@capgo/capacitor-social-login": "^8.5.12",
    "@fontsource/carlito": "^5.3.0",
    "@vercel/functions": "^3.10.4",
    "clipper-lib": "^6.4.2",
    "docx": "^8.5.0",
    "dompurify": "^3.4.17",
    "firebase": "^13.1.0",
    "firebase-admin": "14.5.0",
    "harfbuzzjs": "^1.6.2",
    "html2pdf.js": "^0.14.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.39.0",
    "next": "^15.5.28",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "svg2pdf.js": "^2.8.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@playwright/test": "^1.62.1",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.28",
    "firebase-tools": "^15.34.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "undici@^6.0.0": "^6.29.1",
    "@grpc/grpc-js": "^1.14.5",
    "postcss": "^8.5.26",
    "brace-expansion@^1.0.0": "^1.1.21",
    "brace-expansion@^5.0.0": "^5.0.12",
    "@vercel/cli-config": {
      "zod": "^4.6.6"
    }
  },
  "engines": {
    "node": "24.x"
  }
}
